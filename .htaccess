# ============================================
# WrapNatics POS - Clean URLs & Security Rules
# ============================================
RewriteEngine On

# SUBDOMAIN ROUTING (Root directory na ang wrapnaticspos folder)
RewriteBase /

# --------------------------------------------
# 1. SECURITY DIRECTIVES
# --------------------------------------------
# Proteksyon sa Directory Browsing (Iwas silip sa files)
Options -Indexes

# Proteksyon sa Sensitive Files (Harangan ang SQL, htaccess, at Markdown)
<FilesMatch "\.(sql|htaccess|env|git|md|log)$">
    Require all denied
</FilesMatch>

# Automatically force HTTPS (SSL Encryption)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --------------------------------------------
# 2. CLEAN URL REWRITING RULES
# --------------------------------------------
# Direct browser requests to .php will redirect to extensionless URL
RewriteCond %{THE_REQUEST} \s/+(.*)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=302,L]

# Internally serve matching .php file for extensionless request
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]